{
  "name": "fcos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:full": "node scripts/dev-server.mjs -- node scripts/fcos-connections.mjs run vercel -- dev",
    "dev:ui": "node scripts/dev-server.mjs",
    "dev:status": "node scripts/dev-server.mjs status",
    "dev:stop": "node scripts/dev-server.mjs stop",
    "local:services:start": "node scripts/local-services.mjs start",
    "local:services:status": "node scripts/local-services.mjs status",
    "local:services:stop": "node scripts/local-services.mjs stop",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build": "node scripts/write-app-version.mjs && vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "migrate:hedge-desk": "node scripts/migrate-hedge-desk.mjs",
    "backfill:hedge-physical-salesforce": "node scripts/backfill-physical-hedge-salesforce-costs.mjs",
    "migrate:email-router": "node scripts/migrate-email-router.mjs",
    "reconcile:email-router": "node scripts/reconcile-email-router.mjs",
    "migrate:account-managers": "node --env-file=.env.local scripts/migrate-account-managers.mjs",
    "migrate:special-term-clauses": "node scripts/migrate-special-term-clause-bank.mjs",
    "migrate:variable-charges": "node scripts/backfill-variable-charges.mjs",
    "migrate:variable-charge-sides": "node --env-file=.env.local scripts/backfill-variable-charge-paired-sides.mjs",
    "salesforce:deploy:all": "node scripts/deploy-salesforce-environments.mjs",
    "salesforce:validate:all": "node scripts/deploy-salesforce-environments.mjs --check-only",
    "salesforce:mirror:verify": "node scripts/sync-salesforce-shared-repository.mjs --check",
    "salesforce:mirror:publish": "node scripts/sync-salesforce-shared-repository.mjs --publish",
    "improvements:agent": "node --env-file=.env.local scripts/fcos-improvements.mjs",
    "typecheck": "tsc -p ./jsconfig.json && tsc -p ./jsconfig.core.json",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:graph-only": "node scripts/verify-production-source.mjs",
    "verify:performance": "node scripts/verify-performance-budgets.mjs",
    "verify:compatibility": "node scripts/verify-compatibility-registry.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:fcuno-contract": "node scripts/verify-fcuno-federation-contract.mjs",
    "connections:verify": "node scripts/fcos-connections.mjs verify",
    "connections:doctor": "node scripts/fcos-connections.mjs doctor",
    "connections:bootstrap": "node scripts/fcos-connections.mjs bootstrap",
    "connections:auth": "node scripts/fcos-connections.mjs auth",
    "connections:keychain": "node scripts/fcos-connections.mjs keychain",
    "connections:cli": "node scripts/fcos-connections.mjs run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
