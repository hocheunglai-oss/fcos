#!/bin/sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
if [ -z "$git_common_dir" ]; then
  git_common_dir="$repo_root/.git"
fi
github_config_dir="$(dirname "$git_common_dir")/.fcos-cli/github"
expected_account="$(git config --local --get fcos.expectedGithubAccount)"
remote_name="$1"
remote_url="$2"
if [ -z "$remote_url" ]; then
  remote_url="$(git remote get-url --push "$remote_name" 2>/dev/null || true)"
fi
updates="$(cat)"

case "$remote_url" in
  *github.com/hocheunglai-oss/fcos*) ;;
  *) exit 0 ;;
esac

if [ -z "$repo_root" ] || [ "$expected_account" != "hocheunglai-oss" ]; then
  echo "FCOS push blocked: the repository-local GitHub policy is not configured." >&2
  echo "Run npm run connections:bootstrap -- github." >&2
  exit 1
fi

actual_account="$(env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$github_config_dir" gh api user --jq .login 2>/dev/null || true)"
if [ "$actual_account" != "$expected_account" ]; then
  echo "FCOS push blocked: the isolated GitHub CLI identity does not match '$expected_account'." >&2
  echo "Run npm run connections:verify -- github before pushing." >&2
  exit 1
fi

# New refs must exclude history actually advertised by this push destination,
# not history inferred from origin/main or potentially stale tracking refs.
# A failed read/unknown advertised object never excludes any local history.
published_loaded=0
published_commits=""
load_published_history() {
  [ "$published_loaded" -eq 0 ] || return
  published_loaded=1
  advertised="$(env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$github_config_dir" git ls-remote --refs --heads --tags "$remote_url" 2>/dev/null)" || advertised=""
  published_commits="$(printf '%s\n' "$advertised" | while read -r advertised_sha advertised_ref; do
    if ! printf '%s\n' "$advertised_ref" | grep -Eq '^refs/(heads|tags)/'; then continue; fi
    # Only native SHA-1 object IDs are accepted as revision arguments.
    if ! printf '%s\n' "$advertised_sha" | grep -Eq '^[0-9a-f]{40}$'; then continue; fi
    git rev-parse --verify "$advertised_sha^{commit}" 2>/dev/null || true
  done)"
}

salesforce_changed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if ! printf '%s\n' "$local_sha" | grep -Eq '^[0-9a-f]{40}$' || ! git cat-file -e "$local_sha^{commit}" 2>/dev/null; then
    salesforce_changed=1
    continue
  fi
  # A shallow boundary can conceal earlier metadata edits or missing parents.
  if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" != false ]; then
    salesforce_changed=1
    continue
  fi
  set -- "$local_sha" --not
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      load_published_history
      for published_sha in $published_commits; do set -- "$@" "$published_sha"; done
      ;;
    *)
      # Preserve the existing-ref net-change gate, including force pushes to
      # already-published history. Also inspect new intermediate/merge edits.
      if ! printf '%s\n' "$remote_sha" | grep -Eq '^[0-9a-f]{40}$'; then
        salesforce_changed=1
        continue
      fi
      changed_paths="$(git diff --name-only "$remote_sha" "$local_sha" -- force-app/main/default/ 2>/dev/null)" || salesforce_changed=1
      if [ -n "$changed_paths" ]; then salesforce_changed=1; fi
      set -- "$@" "$remote_sha"
      ;;
  esac
  introduced_commits="$(git rev-list "$@" 2>/dev/null)" || { salesforce_changed=1; continue; }
  for commit in $introduced_commits; do
    # --root sees initial additions; -m inspects every merge parent rather
    # than silently accepting a merge resolution or inherited side change.
    changed_paths="$(git diff-tree --root -m --no-commit-id --name-only -r "$commit" -- force-app/main/default/ 2>/dev/null)" || { salesforce_changed=1; break; }
    if [ -n "$changed_paths" ]; then salesforce_changed=1; break; fi
  done
done <<EOF
$updates
EOF

if [ "$salesforce_changed" -eq 1 ]; then
  git_local_environment="$(git rev-parse --local-env-vars)"
  if ! (unset $git_local_environment; npm run salesforce:mirror:verify); then
    echo "FCOS push blocked: Salesforce metadata must be published byte-for-byte to ivanyk20/fcbhk first." >&2
    echo "Run npm run salesforce:mirror:publish, then retry this push." >&2
    exit 1
  fi
fi

exit 0
