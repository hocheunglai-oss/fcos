#!/bin/sh

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
git_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
if [ -z "$git_common_dir" ]; then
  git_common_dir="$repo_root/.git"
fi
github_config_dir="$(dirname "$git_common_dir")/.fcos-cli/github"
expected_account="$(git config --local --get fcos.expectedGithubAccount)"
remote_name="$1"
remote_url="$2"
if [ -z "$remote_url" ]; then
  remote_url="$(git remote get-url --push "$remote_name" 2>/dev/null)"
fi
updates="$(cat)"

case "$remote_url" in
  https://github.com/hocheunglai-oss/fcos|https://github.com/hocheunglai-oss/fcos.git|git@github.com:hocheunglai-oss/fcos|git@github.com:hocheunglai-oss/fcos.git|ssh://git@github.com/hocheunglai-oss/fcos|ssh://git@github.com/hocheunglai-oss/fcos.git) ;;
  *github.com/hocheunglai-oss/fcos*|*github.com:hocheunglai-oss/fcos*)
    echo "FCOS push blocked: the target remote URL does not exactly match the pinned repository." >&2
    exit 1 ;;
  *) exit 0 ;;
esac

if [ -z "$repo_root" ] || [ "$expected_account" != "hocheunglai-oss" ]; then
  echo "FCOS push blocked: the repository-local GitHub policy is not configured." >&2
  echo "Run npm run connections:bootstrap -- github." >&2
  exit 1
fi

actual_account="$(env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$github_config_dir" gh api user --jq .login 2>/dev/null || true)"
if [ "$actual_account" != "$expected_account" ]; then
  echo "FCOS push blocked: the isolated GitHub CLI identity does not match '$expected_account'." >&2
  echo "Run npm run connections:verify -- github before pushing." >&2
  exit 1
fi

# Local replacement/grafted/shallow history is not evidence of what the remote published.
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS

# Create-only review refs supply immutable source to the protected release.
# The controller still requires DEVEE deployment and a strict mirror before QAT.
review_prefix=refs/heads/codex/fcos-salesforce-review/
if printf '%s\n' "$updates" | awk -v prefix="$review_prefix" 'index($3, prefix) == 1 { found=1 } END { exit !found }'; then
  review_sha="$(printf '%s\n' "$updates" | awk -v prefix="$review_prefix" '
    NF { rows++ }
    NF == 4 && length($2) == 40 && $2 ~ /^[0-9a-f]+$/ && $2 !~ /^0+$/ &&
      $3 == prefix $2 && length($4) == 40 && $4 ~ /^0+$/ { sha=$2 }
    END { if (rows != 1 || !sha) exit 1; print sha }')" || {
    echo "FCOS push blocked: Salesforce review refs accept one new exact commit and cannot be updated." >&2
    exit 1
  }
  if [ -s "$git_common_dir/info/grafts" ] || [ -s "$git_common_dir/shallow" ] \
    || [ -n "${GIT_GRAFT_FILE:-}" ] || [ -n "${GIT_SHALLOW_FILE:-}" ]; then
    echo "FCOS push blocked: Salesforce review source requires complete, unmodified Git history." >&2
    exit 1
  fi
  review_repository="$(env -u GH_TOKEN -u GITHUB_TOKEN GH_CONFIG_DIR="$github_config_dir" gh api repos/hocheunglai-oss/fcos --jq '.full_name + ":" + (.id|tostring)' 2>/dev/null)" || exit 1
  if [ "$review_repository" != "hocheunglai-oss/fcos:1278654816" ]; then
    echo "FCOS push blocked: Salesforce review source requires the pinned FCOS repository." >&2
    exit 1
  fi
  hook_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)" || exit 1
  review_manifest="${FCOS_SALESFORCE_REVIEW_RELEASE_MANIFEST:-}"
  git_local_environment="$(git rev-parse --local-env-vars)" || exit 1
  if [ -z "$review_manifest" ] || ! (
    unset $git_local_environment
    export GIT_NO_REPLACE_OBJECTS=1
    node "$hook_directory/../scripts/verify-salesforce-review-source.mjs" "$repo_root" "$review_sha" "$review_manifest"
  ); then
    echo "FCOS push blocked: Salesforce review source requires its exact verified release manifest." >&2
    exit 1
  fi
  exit 0
fi

verify_advertised_commits() {
  git cat-file --batch-check='%(objectname) %(objecttype)' < "$publication_check/published" > "$publication_check/objects" 2>/dev/null || return 1
  if awk 'NF != 2 || $2 != "commit" {bad=1} END {exit bad}' "$publication_check/objects"; then
    return 0
  fi
  # A fresh release journal or main update may be advertised before this
  # checkout has the objects. Fetch only those exact IDs, without updating refs.
  awk 'NF != 2 || length($1) != 40 || $1 ~ /[^0-9a-f]/ || ($2 != "commit" && $2 != "missing") {bad=1}
    $2 == "missing" {print $1; missing++} END {exit (bad || missing < 1 || missing > 8)}' \
    "$publication_check/objects" > "$publication_check/missing" || return 1
  set --
  while IFS= read -r object; do set -- "$@" "$object"; done < "$publication_check/missing"
  git fetch --no-tags --no-write-fetch-head --no-recurse-submodules --no-auto-maintenance "$remote_url" "$@" >/dev/null 2>&1 || return 1
  git cat-file --batch-check='%(objectname) %(objecttype)' < "$publication_check/published" > "$publication_check/objects" 2>/dev/null \
    && awk 'NF != 2 || $2 != "commit" {bad=1} END {exit bad}' "$publication_check/objects"
}

# Fail conservatively unless every revision can be checked against a fresh advertisement
# from this exact push target. Local tracking refs are never publication evidence.
salesforce_changed=1
publication_check="$(mktemp -d "${TMPDIR:-/tmp}/fcos-pre-push.XXXXXX" 2>/dev/null)"
if [ -n "$publication_check" ] && [ -d "$publication_check" ]; then
  trap 'rm -rf "$publication_check"' EXIT HUP INT TERM
  if [ ! -s "$git_common_dir/info/grafts" ] && [ ! -s "$git_common_dir/shallow" ] \
    && [ -z "${GIT_GRAFT_FILE:-}" ] && [ -z "${GIT_SHALLOW_FILE:-}" ] \
    && awk 'NF && (NF != 4 || length($2) != 40 || $2 ~ /[^0-9a-f]/ || length($4) != 40 || $4 ~ /[^0-9a-f]/) {bad=1}
    NF == 4 && $2 !~ /^0+$/ {print $2} END {exit bad}' > "$publication_check/tips" <<EOF
$updates
EOF
  then
    if [ ! -s "$publication_check/tips" ]; then
      salesforce_changed=0
    elif git ls-remote --heads "$remote_url" > "$publication_check/advertised" 2>/dev/null \
      && [ -s "$publication_check/advertised" ] \
      && awk 'NF != 2 || length($1) != 40 || $1 ~ /[^0-9a-f]/ || $2 !~ /^refs\/heads\// {bad=1} END {exit bad}' "$publication_check/advertised"; then
      # A review-only ref cannot satisfy ordinary Salesforce publication.
      awk -v prefix="$review_prefix" 'index($2, prefix) != 1 { print $1 }' "$publication_check/advertised" \
        | sort -u > "$publication_check/published"
      if [ -s "$publication_check/published" ] && verify_advertised_commits; then
        cat "$publication_check/tips" > "$publication_check/revisions"
        awk '{print "^" $1}' "$publication_check/published" >> "$publication_check/revisions"
        if git rev-list --stdin < "$publication_check/revisions" > "$publication_check/unpublished" 2>/dev/null; then
          if [ ! -s "$publication_check/unpublished" ]; then
            salesforce_changed=0
          # Inspect every unpublished commit, including every merge parent. A later
          # revert cannot erase its Salesforce publication obligation.
          elif git diff-tree --stdin --root -r -m --no-commit-id --name-only --no-renames \
            < "$publication_check/unpublished" > "$publication_check/changes" 2>/dev/null; then
            grep -q '^force-app/main/default/' "$publication_check/changes"
            if [ "$?" -eq 1 ]; then
              salesforce_changed=0
            fi
          fi
        fi
      fi
    fi
  fi
fi

if [ "$salesforce_changed" -eq 1 ]; then
  git_local_environment="$(git rev-parse --local-env-vars)"
  if ! (unset $git_local_environment; npm run salesforce:mirror:verify); then
    echo "FCOS push blocked: Salesforce metadata must be published byte-for-byte to ivanyk20/fcbhk first." >&2
    echo "Run npm run salesforce:mirror:publish, then retry this push." >&2
    exit 1
  fi
fi

exit 0
