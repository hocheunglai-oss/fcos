<apex:page controller="FcosNativeCreditController" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false">
<html><head><style type="text/css">body{font-family:Helvetica,Arial,sans-serif;font-size:10pt;color:#18232f}h1{font-size:19pt}h2{font-size:14pt}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border-bottom:1px solid #ccc;padding:8px;text-align:left}.amount{text-align:right}.small{font-size:8pt}.total{font-weight:bold;font-size:13pt;margin-top:20px}</style></head><body>
<h2><apex:outputText value="{!presentation['legalEntity']}"/></h2>
<p class="small"><apex:outputText value="{!presentation['companyContact']}"/></p>
<h1><apex:outputText value="{!title}"/></h1>
<p>Reference: <apex:outputText value="{!reference}"/><br/><apex:outputPanel rendered="{!showOriginal}">Source proforma / original invoice: <apex:outputText value="{!originalReference}"/><br/></apex:outputPanel>Counterparty: <apex:outputText value="{!counterparty}"/><br/><apex:outputText value="{!dateLabel}"/>: <apex:outputText value="{0,date,yyyy-MM-dd}"><apex:param value="{!creditDate}"/></apex:outputText></p>
<p><apex:outputText value="{!reason}"/></p>
<table><thead><tr><th>Description</th><th>Quantity / Unit</th><th>Pricing basis</th><th class="amount">Unit price ({!currencyCode})</th><th class="amount">{!amountLabel} ({!currencyCode})</th></tr></thead><tbody>
<apex:repeat value="{!lines}" var="line"><tr><td><apex:outputText value="{!line.Description__c}"/></td><td><apex:outputText value="{!line.Quantity__c}"/> <apex:outputText value="{!line.Unit__c}"/></td><td><apex:outputText value="{!line.Pricing_Mode__c}"/><br/>Minimum: <apex:outputText value="{!line.Native_Minimum__c}"/><br/>Lumpsum: <apex:outputText value="{!line.Native_Lumpsum__c}"/></td><td class="amount"><apex:outputText value="{!line.Native_Unit_Price__c}"/></td><td class="amount"><apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!exactLineAmounts[line.Id]}"/></apex:outputText></td></tr></apex:repeat>
</tbody></table>
<p class="total">Total: {!currencyCode} <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!total}"/></apex:outputText></p>
<p class="small">USD accounting equivalent: <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!usd}"/></apex:outputText><apex:outputPanel rendered="{!isHkd}"><br/>Original confirmed company rate: USD 1 = HKD <apex:outputText value="{!rate}"/><br/>Rate revision: <apex:outputText value="{!revision}"/></apex:outputPanel></p>
<apex:outputPanel rendered="{!showDeposit}"><p><strong>Deposit request: </strong>{!currencyCode} <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!depositRequested}"/></apex:outputText><apex:outputPanel rendered="{!isHkd}"> (USD accounting equivalent <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!depositUsdEquivalent}"/></apex:outputText>)</apex:outputPanel>, due <apex:outputText value="{0,date,yyyy-MM-dd}"><apex:param value="{!depositDueDate}"/></apex:outputText>.</p></apex:outputPanel><p><apex:outputText value="{!footerText}"/></p>
</body></html></apex:page>
