<aura:component implements="lightning:actionOverride,flexipage:availableForRecordHome,force:hasRecordId" access="global" controller="OverrideNewVesselController">
    <aura:attribute name="VesselName" type="string" />
    <aura:attribute name="IMO" type="string" />
    <aura:attribute name="NRT" type="Decimal" />
    <aura:attribute name="Remark" type="string" />
    <lightning:overlayLibrary aura:id="overlayLib" />
    <lightning:notificationsLibrary aura:id="notifLib"/>
    <div aura:id="editDialog" role="dialog" tabindex="-1" aria-labelledby="new-vessel-heading" class="slds-modal slds-fade-in-open">
        <div class="slds-modal__container">
            <div class="slds-modal__header"><h2 id="new-vessel-heading" class="slds-text-heading_medium">New Vessel</h2></div>
            <div class="slds-modal__content slds-p-around_medium">
                <lightning:input aura:id="name" name="Name" label="Vessel Name" value="{!v.VesselName}" onchange="{!c.handleVesselNameToUpperCase}" required="true"/>
                <lightning:input name="IMO" label="IMO" value="{!v.IMO}" maxlength="7"/>
                <lightning:input name="NRT" type="number" label="Net Registered Tonnage (NRT)" value="{!v.NRT}" min="1" step="1" message-when-range-underflow="NRT must be a positive whole number."/>
                <lightning:input name="Remark" label="Remark" value="{!v.Remark}"/>
            </div>
            <div class="slds-modal__footer">
                <lightning:button variant="neutral" aura:id="cancelId" label="Cancel" onclick="{!c.cancel}" />
                <lightning:button aura:id="saveAndNewId" variant="neutral" label="Save &amp; New" onclick="{!c.saveRecord}" />
                <lightning:button aura:id="saveId" variant="brand" label="Save" onclick="{!c.saveRecord}" />
            </div>
        </div>
    </div>
    <div class="slds-backdrop slds-backdrop_open"></div>
</aura:component>
